DEEPAGENTS_MODEL=openai:MiniMax-M2.7
OPENAI_API_KEY=replace-with-openai-compatible-key
OPENAI_BASE_URL=https://api.minimaxi.com/v1

CHECKPOINT_BACKEND=auto
LANGFUSE_ENABLED=1
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_BASE_URL=http://localhost:3000
